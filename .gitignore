Chalant.xcodeproj/
# The iPhone app. Its project, Info.plists and entitlements all come out of
# Notes/project.yml on every `xcodegen generate`, so none is checked in.
Notes/Notes.xcodeproj/
Notes/Notes/Info.plist
Notes/Notes/Notes.entitlements
Notes/NotesWidget/Info.plist
Notes/NotesWidget/NotesWidget.entitlements
DerivedData/
build/
.DS_Store
.playwright-mcp/
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml

# Agent tooling scratch, not part of the app
_bmad/
# Ignore the contents, not the directory itself: git never descends into an
# excluded directory, so a negation under one never applies.
_bmad-output/*
# ...except the loop-loop record: plan docs are the approved contract
# and summary docs are the durable history. Both belong in the repo.
!_bmad-output/loop-loop/
.bmad-loop/
.claude/

# The single-scale reps that tiffutil folds into the disk image's
# background. packaging/dmg-background.tiff is the committed artifact;
# these two are just its ingredients, rebuilt by
# scripts/make-dmg-background.py whenever GEOMETRY changes.
packaging/background.png
packaging/background@2x.png
