#!/bin/bash
# Dev loop: regenerate, build, relaunch. Builds Debug, which project.yml
# signs with the development identity, so a dev build and an installed
# build do not fight over Keychain and TCC grants. Override the team
# with CHALANT_TEAM=<id> if you sign with a different one.
set -euo pipefail

cd "$(dirname "$0")/.."
# project.yml is the only place the team is written down. A second copy
# here is a second thing to forget on the day the team changes.
TEAM="${CHALANT_TEAM:-$(awk '/^ *DEVELOPMENT_TEAM:/ {print $2; exit}' project.yml)}"

command -v xcodegen >/dev/null && xcodegen --quiet

xcodebuild -scheme Chalant -configuration Debug -destination 'platform=macOS' \
  DEVELOPMENT_TEAM="$TEAM" CODE_SIGN_STYLE=Automatic -allowProvisioningUpdates \
  build 2>&1 | grep -E "error:|warning: .*(deprecat|unused)|BUILD (SUCCEEDED|FAILED)" || true

APP=$(find ~/Library/Developer/Xcode/DerivedData -name Chalant.app -path '*Debug*' \
      -not -path '*Index.noindex*' 2>/dev/null | head -1)
[ -n "$APP" ] || { echo "No built app found"; exit 1; }

pkill -x Chalant 2>/dev/null || true
sleep 0.5
open "$APP"
echo "Launched $APP"
echo "Logs: ./scripts/devlog"
