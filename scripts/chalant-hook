#!/bin/bash
# Claude Code hook -> the island.
#
# Claude Code hands a hook one JSON object on stdin and expects it to
# be quick and quiet. This reads the session id and the message out of
# that and pushes a pill, so a session that wants you says so on the
# island instead of only in whatever terminal it happens to be in.
#
# Install by adding to ~/.claude/settings.json:
#
#   {
#     "hooks": {
#       "Notification": [
#         { "hooks": [ { "type": "command",
#                        "command": "/full/path/to/scripts/chalant-hook" } ] }
#       ],
#       "Stop": [
#         { "hooks": [ { "type": "command",
#                        "command": "/full/path/to/scripts/chalant-hook" } ] }
#       ]
#     }
#   }
#
# A hook that fails must never be the reason a session stops, so every
# path here exits 0 and stays silent. Chalant not running is the
# ordinary case, not an error worth interrupting anybody over.
set -uo pipefail

PORT="${CHALANT_PORT:-4242}"
BASE="http://localhost:$PORT"
TOKEN_FILE="${CHALANT_TOKEN_FILE:-$HOME/Library/Application Support/Chalant/api-token}"
TOKEN="${CHALANT_TOKEN:-}"
if [ -z "$TOKEN" ] && [ -r "$TOKEN_FILE" ]; then
  TOKEN="$(cat "$TOKEN_FILE")"
fi
[ -n "$TOKEN" ] || exit 0

PAYLOAD="$(cat)"
[ -n "$PAYLOAD" ] || exit 0

# python3 rather than sed: this is JSON from another program, and a
# message with a quote or a newline in it would take a regex apart.
read -r EVENT SESSION STOP_ACTIVE TITLE <<EOF
$(printf '%s' "$PAYLOAD" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
event = (d.get("hook_event_name") or "").strip() or "Notification"
session = (d.get("session_id") or "").strip()
# The folder is what a person recognises a session by; the raw message
# is often "Claude needs your permission to use Bash", which says
# nothing about which of five sessions it came from.
cwd = (d.get("cwd") or "").rstrip("/")
where = cwd.rsplit("/", 1)[-1] if cwd else ""
title = where or session[:8] or "a session"
# Set when a Stop hook is already running for this turn. The field
# name is believed, not documented (notch-messaging-evidence); the
# real guard against a double delivery is the once-only collection
# below, which does not depend on this at all.
stop_active = "1" if d.get("stop_hook_active") else "0"
print(event, session or "-", stop_active, title.replace(" ", " "))
' 2>/dev/null)
EOF

[ -n "${SESSION:-}" ] && [ "${SESSION:-}" != "-" ] || exit 0
TITLE="${TITLE//$' '/ }"

case "$EVENT" in
  Notification) STATE="needs-input"; WHAT="$TITLE wants you" ;;
  Stop)         STATE="done";        WHAT="$TITLE finished" ;;
  *)            exit 0 ;;
esac

esc() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read())[1:-1])'; }

curl -s --max-time 2 -H "X-Chalant-Token: $TOKEN" "$BASE/activity" \
  -d "{\"id\":\"claude-$(esc "$SESSION")\",\"title\":\"$(esc "$WHAT")\",\"state\":\"$STATE\"}" \
  >/dev/null 2>&1

# A message the user left on the island, collected at the turn
# boundary — the only moment a Stop hook gets to say anything back.
# Notification does not reach here: a permission prompt is not a turn
# boundary, and nothing would be there to collect yet.
if [ "$EVENT" = "Stop" ] && [ "${STOP_ACTIVE:-0}" != "1" ]; then
  # $SESSION, not "claude-$SESSION": the pill above uses the prefixed
  # id, but the outbox route (like /ask) takes the bare session id
  # Claude Code itself uses. Using the prefixed id here 404s forever
  # with nothing anywhere saying why.
  OUTBOX="$(curl -s --connect-timeout 1 --max-time 2 -H "X-Chalant-Token: $TOKEN" \
    "$BASE/outbox/$SESSION" 2>/dev/null)"
  printf '%s' "$OUTBOX" | python3 -c '
import json, sys
try:
    body = json.load(sys.stdin)
except Exception:
    sys.exit(0)
message = body.get("message")
if not message:
    sys.exit(0)
# Built with json.dumps, never string interpolation: this message came
# from a user and may contain a quote, a newline or a backslash, and
# still has to become one well-formed JSON object on stdout.
print(json.dumps({
    "decision": "block",
    "reason": "A message arrived from Chalant.",
    "hookSpecificOutput": {
        "hookEventName": "Stop",
        "additionalContext": message,
    },
}))
' 2>/dev/null
fi

exit 0
