#!/bin/bash
# The open door, one word at a time. Talks to the Chalant island's
# localhost activity API (see README, Live status).
#
#   chalant working  "Deploying api"        [id]
#   chalant needs-input "Claude wants you"  [id]
#   chalant done     "Build finished"       [id]
#   chalant failed   "Tests broke"          [id]
#   chalant clear    [id]
#   chalant list
#   chalant ask <session-id> "Question?" [option ...]
#   chalant pending                        what is held at the door
#   chalant approve <call-id>
#   chalant deny    <call-id>
#
# The id defaults to "cli"; give one to run several statuses at once.
set -euo pipefail
PORT="${CHALANT_PORT:-4242}"
BASE="http://localhost:$PORT"

# The door is loopback-only but loopback is not a wall: every process on
# the machine can knock, including other accounts. Chalant mints this on
# first launch and keeps it at 0600, so anyone who is already you can
# read it and nobody else can. Set CHALANT_TOKEN to override.
TOKEN_FILE="${CHALANT_TOKEN_FILE:-$HOME/Library/Application Support/Chalant/api-token}"
TOKEN="${CHALANT_TOKEN:-}"
if [ -z "$TOKEN" ] && [ -r "$TOKEN_FILE" ]; then
  TOKEN="$(cat "$TOKEN_FILE")"
fi
if [ -z "$TOKEN" ]; then
  echo "chalant: no token. Launch Chalant once to mint $TOKEN_FILE," >&2
  echo "         or set CHALANT_TOKEN." >&2
  exit 1
fi
AUTH=(-H "X-Chalant-Token: $TOKEN")

case "${1:-}" in
  working|needs-input|done|failed)
    STATE="$1"
    TITLE="${2:?usage: chalant $1 \"title\" [id]}"
    ID="${3:-cli}"
    # Escape backslashes and quotes so a title with either still forms
    # valid JSON instead of a silently-dropped 400.
    esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
    curl -sf "${AUTH[@]}" "$BASE/activity" -d "{\"id\":\"$(esc "$ID")\",\"title\":\"$(esc "$TITLE")\",\"state\":\"$STATE\"}" >/dev/null
    echo "on the island: [$STATE] $TITLE"
    ;;
  clear)
    ID="${2:-cli}"
    curl -sf "${AUTH[@]}" -X DELETE "$BASE/activity/$ID" >/dev/null
    echo "cleared: $ID"
    ;;
  list)
    curl -sf "${AUTH[@]}" "$BASE/activities"
    echo
    ;;
  pending)
    # Tool calls held at the door, waiting on a yes or no.
    curl -sf "${AUTH[@]}" "$BASE/permissions"
    echo
    ;;
  approve|deny)
    # chalant approve <call-id> | chalant deny <call-id>
    #
    # The same decision the island's buttons make. Here so the whole
    # path can be proved from a terminal without spending somebody's
    # real authorisation on a screenshot.
    CALL="${2:-}"
    [ -n "$CALL" ] || { echo "usage: chalant $1 <call-id>" >&2; exit 2; }
    VERDICT="allow"; [ "$1" = "deny" ] && VERDICT="deny"
    curl -sf "${AUTH[@]}" -X PUT "$BASE/permission/$CALL" \
      -d "{\"decision\":\"$VERDICT\"}" >/dev/null
    echo "$VERDICT: $CALL"
    ;;
  message)
    # chalant message <session-id> "text"
    #
    # Queues a message for a running agent, exactly as the island's
    # composer does. It is collected by that session's Stop hook at the
    # end of its next turn, so nothing arrives mid-run. Exists so the
    # path can be exercised without a person typing into the notch and
    # spending their real message on a test.
    SESSION="${2:?usage: chalant message <session-id> \"text\"}"
    TEXT="${3:?usage: chalant message <session-id> \"text\"}"
    esc() { printf '%s' "$1" | python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.stdin.read())[1:-1])'; }
    if ! curl -sf "${AUTH[@]}" "$BASE/outbox" \
        -d "{\"session\":\"$(esc "$SESSION")\",\"message\":\"$(esc "$TEXT")\"}" >/dev/null; then
      echo "chalant: the island would not take that message for $SESSION" >&2
      exit 1
    fi
    echo "queued for $SESSION; it arrives when that session next comes to rest"
    ;;
  ask)
    # chalant ask <session-id> "Question?" [option ...]
    #
    # Blocks until the question is answered on the island, then prints
    # the chosen options one per line. This is the shape a hook wants:
    # ask, wait, read stdout. Chalant cannot push an answer into a
    # running agent, so the agent comes and collects it.
    SESSION="${2:?usage: chalant ask <session-id> \"question\" [option ...]}"
    QUESTION="${3:?usage: chalant ask <session-id> \"question\" [option ...]}"
    shift 3
    esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
    OPTS=""
    for o in "$@"; do
      [ -n "$OPTS" ] && OPTS="$OPTS,"
      OPTS="$OPTS\"$(esc "$o")\""
    done
    if ! curl -sf "${AUTH[@]}" "$BASE/ask" \
        -d "{\"session\":\"$(esc "$SESSION")\",\"question\":\"$(esc "$QUESTION")\",\"options\":[$OPTS]}" >/dev/null; then
      echo "chalant: the island does not know session $SESSION" >&2
      exit 1
    fi
    # Polled, not streamed: a shell has no good way to hold a socket
    # open for an answer that may take minutes, and a second per poll
    # is invisible next to a human deciding.
    while true; do
      REPLY_JSON=$(curl -sf "${AUTH[@]}" "$BASE/ask/$SESSION" || true)
      case "$REPLY_JSON" in
        *'"answered":true'*)
          # python3, not sed and tr. The old form split the answer
          # array on every comma, so an option whose own label contained
          # one came back torn in half: picking "Multi-question asks, so
          # a bundled call shows all of them" printed two lines, and a
          # caller reading one choice per line got two choices that were
          # never offered (2026-08-03, caught answering a real question
          # from the island). JSON is not a comma-separated string and
          # cannot be parsed as one.
          printf '%s' "$REPLY_JSON" | python3 -c '
import json, sys
try:
    body = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for choice in body.get("answer") or []:
    print(choice)
'
          exit 0
          ;;
        '') echo "chalant: the island stopped answering" >&2; exit 1 ;;
      esac
      sleep 1
    done
    ;;
  *)
    sed -n '2,13p' "$0"
    exit 1
    ;;
esac
