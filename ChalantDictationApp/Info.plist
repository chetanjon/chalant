<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Part 2 §5. Missing any one of these produces a silent permission
	     failure that reads like a code bug. Proven twice on 2026-08-12:
	     without NSMicrophoneUsageDescription the system never prompts, the
	     engine starts happily, and every recording is silence.

	     This file is hand-written and referenced by INFOPLIST_FILE. Do NOT
	     move it under xcodegen's `info:` key: that generates the file and
	     will overwrite this with a stub.

	     NOTE: §5 says "four usage descriptions" but lists
	     NSAppleEventsUsageDescription twice, and a duplicate key is invalid
	     in a plist. Three distinct keys are shipped. Accessibility, Input
	     Monitoring and Screen Recording have no Info.plist key at all. -->

	<key>CFBundleName</key>
	<string>ChalantDictation</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>Chalant listens only while you hold the dictation key. Audio never leaves your Mac.</string>

	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech is transcribed on-device by macOS. Nothing is uploaded.</string>

	<!-- Covers both the AppleScript path and the Automation prompt. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Chalant asks System Events to paste your dictated text into the app you were using.</string>

	<!-- Part 2 §1: menu bar / notch, no Dock icon, matching Chalant. -->
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
