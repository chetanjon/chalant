<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime closes every door by name. These are the ones
	     Chalant actually walks through, and nothing more. -->

	<!-- Telling Music, Spotify, Messages, and Shortcuts what to do. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!-- Hearing you: dictation feeds every spoken verb. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Deliberately absent: com.apple.security.cs.disable-library-validation.
	     It was here for the now-playing adapter, on the reasoning that
	     the system perl loads a framework Apple did not sign. But
	     library validation is enforced per process, and perl is its own
	     process, so this app's entitlement never governed that load at
	     all. Chalant does not link or dlopen the framework either
	     (project.yml sets link: false, and nothing imports it).

	     It was not free to keep. This app holds Apple Events, the
	     microphone, Contacts, Calendars, Reminders, Screen Recording
	     and Accessibility, and it signs with a pinned identity so those
	     grants persist across builds. The entitlement would let any
	     foreign-signed dylib dropped into the bundle inherit all of it.
	     Verified by removing it and confirming the adapter still
	     streams now-playing. -->
</dict>
</plist>
