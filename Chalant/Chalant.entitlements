<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime closes every door by name. These are the ones
	     Chalant actually walks through, and nothing more. -->

	<!-- Telling Music, Spotify, Messages, and Shortcuts what to do. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!-- Hearing you: dictation feeds every spoken verb. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- Where you are, roughly: the weather line beside your day.
	     The fix is rounded to about a kilometre before it is used. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>

	<!-- Today's events, and the verbs that make them.

	     MISSING FROM 1.10.0 UNTIL 1.12.3, WHICH IS WHY THE DAY PANE
	     WOULD NOT SHOW A CALENDAR NO MATTER WHAT THE USER GRANTED.
	     Under the hardened runtime tccd refuses outright and logs
	     "kTCCServiceCalendar requires entitlement
	     com.apple.security.personal-information.calendars but it is
	     missing", with Auth Right: Unknown (None) and DB Action: None.
	     It never reaches the user as a prompt and never records a
	     decision, so System Settings has nothing to toggle and the
	     denial card is telling the truth. The 1.12.1 and 1.12.2
	     permission work fixed a real staleness bug underneath this
	     one, but could never have cured it. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>

	<!-- The name you say when texting, so it can find a number.
	     Missing for exactly as long, and failing the same silent way:
	     kTCCServiceAddressBook requires
	     com.apple.security.personal-information.addressbook. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>

	<!-- Deliberately absent: com.apple.security.cs.disable-library-validation.
	     It was here for the now-playing adapter, on the reasoning that
	     the system perl loads a framework Apple did not sign. But
	     library validation is enforced per process, and perl is its own
	     process, so this app's entitlement never governed that load at
	     all. Chalant does not link or dlopen the framework either
	     (project.yml sets link: false, and nothing imports it).

	     It was not free to keep. This app holds Apple Events, the
	     microphone, Contacts, Calendars, Reminders, Screen Recording
	     and Accessibility, and it signs with a pinned identity so those
	     grants persist across builds. The entitlement would let any
	     foreign-signed dylib dropped into the bundle inherit all of it.
	     Verified by removing it and confirming the adapter still
	     streams now-playing. -->
</dict>
</plist>
